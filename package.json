{
  "name": "doctor_appointments",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "buildWeb": "npx expo export --platform web",
    "startAndroid": "expo start --android",
    "prebuild": "expo prebuild --platform android --clean",
    "runAndroid": "yarn prebuild && expo run:android",
    "buildAndroidAab": "yarn prebuild && npx react-native build-android --mode=release",
    "buildAndroid": "yarn prebuild && npx react-native build-android --mode=release && ./android/gradlew -p ./android assembleRelease",
    "fixExpo": "npm install && npx expo install --check",
    "avd": "killall -9 qemu-system-x86_64 emulator 2>/dev/null; rm -rf ~/.android/avd/**/*.lock; ~/Android/Sdk/emulator/emulator @$(~/Android/Sdk/emulator/emulator -list-avds | head -n 1)"
  },
  "dependencies": {
    "@expo/ui": "~57.0.8",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.19.0",
    "country-flag-emoji-polyfill": "^0.1.8",
    "expo": "~57.0.9",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-navigation-bar": "~57.0.2",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "google-libphonenumber": "^3.2.46",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-paper-dates": "^0.23.14",
    "react-native-paper-phone-number-input": "^1.3.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "@react-native-community/cli": "latest"
  },
  "private": true
}
